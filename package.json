{
  "name": "@tscircuit/drawing-viewer",
  "version": "0.0.2",
  "description": "React viewer for engineering drawings in Circuit JSON",
  "type": "module",
  "module": "lib/index.ts",
  "types": "lib/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.ts",
      "default": "./lib/index.ts"
    }
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/drawing-viewer"
  },
  "scripts": {
    "start": "cosmos",
    "build:site": "cosmos-export",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@tscircuit/copper-pour-solver": "0.0.67",
    "@tscircuit/core": "0.0.2269",
    "@tscircuit/footprinter": "0.0.450",
    "@tscircuit/image-utils": "0.0.8",
    "@tscircuit/infer-cable-insertion-point": "0.0.5",
    "@tscircuit/miniflex": "0.0.4",
    "@tscircuit/props": "0.0.717",
    "@tscircuit/soup-util": "0.0.41",
    "@types/bun": "^1.3.0",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "fast-png": "^8.0.0",
    "jscad-fiber": "0.0.93",
    "jsdom": "^26.0.0",
    "manifold-3d": "3.5.4",
    "minicssgrid": "0.0.9",
    "react": "19.1.0",
    "react-cosmos": "^6.2.1",
    "react-cosmos-plugin-vite": "^6.2.0",
    "react-dom": "19.1.0",
    "spicey": "0.0.14",
    "transformation-matrix": "^2.16.1",
    "typescript": "^5.9.2",
    "vite": "^6.0.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@tscircuit/circuit-json-to-drawing": "https://jscdn.tscircuit.com/@tscircuit/circuit-json-to-drawing/0.0.4.tgz",
    "circuit-json": "^0.0.543",
    "circuit-json-to-gltf": "0.0.164",
    "poppygl": "^0.0.38"
